# Nusxa oling: cp .env.example .env  va kalitlarni yozing

# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=

# Kamida bittasi kerak. Bo'sh qolgani ishlatilmaydi.
# Gemini: https://aistudio.google.com
GEMINI_API_KEY=
# Groq: https://console.groq.com
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai
OPENROUTER_API_KEY=

# Qaysi tartibda sinab ko'rish
PROVIDER_ORDER=gemini,groq,openrouter

# Limit tugagan xizmatni necha soniya chetlab o'tish
COOLDOWN_SECONDS=60
